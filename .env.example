# Canonical local Compose/backend environment. Copy to ignored root .env.
# Start PostgreSQL from the repository root:
# docker compose -p ai-interview-practice --env-file .env -f .docker/compose.local.yaml up -d
# Start the API from api/ after exporting this file: set -a; . ../.env; set +a
# Then run: go run ./cmd/api (or air)

DB_DATABASE=ai_interview_practice
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432
# Optional full DSN; when nonempty it takes precedence over DB_* connection fields.
DATABASE_URL=

# Empty secrets use distinct development-only defaults. Production requires
# distinct non-placeholder secrets; supply them securely, never commit them.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=600
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=86400

LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT=30s
LLM_MAX_RETRIES=1

# API uses 8080 locally so the frontend can use 3000.
SERVER_PORT=8080
# Comma-separated explicit origins when credentials are enabled.
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
