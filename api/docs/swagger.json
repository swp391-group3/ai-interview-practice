    "definitions": {
        "apperror.Code": {
            "type": "string",
            "enum": [
                "JD_IN_USE",
                "JD_NOT_FOUND",
                "INVALID_CREDENTIALS",
                "USER_NOT_FOUND",
                "USER_INACTIVE",
                "INVALID_TOKEN",
                "VALIDATION_ERROR",
                "INTERNAL_ERROR",
                "INVALID_JD_INPUT",
                "JD_TOO_SHORT",
                "JD_TOO_LONG",
                "EXTRACTION_FAILED",
                "INVALID_EXTRACTION_OUTPUT"
            ],
            "x-enum-varnames": [
                "CodeJDInUse",
                "CodeJDNotFound",
                "CodeInvalidCredentials",
                "CodeAccountNotFound",
                "CodeAccountLocked",
                "CodeInvalidToken",
                "CodeValidation",
                "CodeInternal",
                "CodeInvalidJDInput",
                "CodeJDTooShort",
                "CodeJDTooLong",
                "CodeExtractionFailed",
                "CodeInvalidExtractionOutput"
            ]
        },
        "auth.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "jane@example.com"
                },
                "password": {
                    "type": "string",
                    "example": "SuperSecret123"
                }
            }
        },
        "domain.ExtractedSkill": {
            "type": "object",
            "properties": {
                "category": {
                    "$ref": "#/definitions/domain.SkillCategory"
                },
                "name": {
                    "type": "string"
                },
                "requirement": {
                    "description": "Empty means the JD does not state whether the skill is required or preferred.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/domain.Requirement"
                        }
                    ]
                }
            }
        },
        "domain.ListItem": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "seniorityLevel": {
                    "$ref": "#/definitions/domain.Seniority"
                },
                "status": {
                    "$ref": "#/definitions/domain.Status"
                },
                "title": {
                    "type": "string"
                },
                "updatedAt": {
                    "type": "string"
                }
            }
        },
        "domain.Requirement": {
            "type": "string",
            "enum": [
                "required",
                "preferred"
            ],
            "x-enum-varnames": [
                "Required",
                "Preferred"
            ]
        },
        "domain.Seniority": {
            "type": "string",
            "enum": [
                "intern",
                "junior",
                "mid",
                "senior",
                "lead"
            ],
            "x-enum-varnames": [
                "Intern",
                "Junior",
                "Mid",
                "Senior",
                "Lead"
            ]
        },
        "domain.SkillCategory": {
            "type": "string",
            "enum": [
                "programming_language",
                "framework",
                "database",
                "tool",
                "technology",
                "other"
            ],
            "x-enum-varnames": [
                "ProgrammingLanguage",
                "Framework",
                "Database",
                "Tool",
                "Technology",
                "Other"
            ]
        },
        "domain.Status": {
            "type": "string",
            "enum": [
                "uploaded",
                "parsing",
                "parsed",
                "customized",
                "locked",
                "failed"
            ],
            "x-enum-varnames": [
                "StatusUploaded",
                "StatusParsing",
                "StatusParsed",
                "StatusCustomized",
                "StatusLocked",
                "StatusFailed"
            ]
        },
        "domain.StructuredJD": {
            "type": "object",
            "properties": {
                "domainKnowledge": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "seniorityLevel": {
                    "$ref": "#/definitions/domain.Seniority"
                },
                "skills": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.ExtractedSkill"
                    }
                },
                "technologies": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "handler.AnalyzeJDRequest": {
            "type": "object",
            "required": [
                "rawText"
            ],
            "properties": {
                "rawText": {
                    "type": "string"
                }
            }
        },
        "handler.CreateJDRequest": {
            "type": "object",
            "required": [
                "rawText",
                "structuredJD"
            ],
            "properties": {
                "rawText": {
                    "type": "string"
                },
                "structuredJD": {
                    "$ref": "#/definitions/domain.StructuredJD"
                }
            }
        },
        "handler.JDResponse": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "rawText": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/domain.Status"
                },
                "structuredJD": {
                    "$ref": "#/definitions/domain.StructuredJD"
                },
                "updatedAt": {
                    "type": "string"
                }
            }
        },
        "handler.UpdateJDRequest": {
            "type": "object",
            "required": [
                "structuredJD"
            ],
            "properties": {
                "structuredJD": {
                    "$ref": "#/definitions/domain.StructuredJD"
                }
            }
        },
        "response.Envelope": {
            "type": "object",
            "properties": {
                "data": {},
                "error": {
                    "$ref": "#/definitions/response.ErrorBody"
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "response.ErrorBody": {
            "type": "object",
            "properties": {
                "code": {
                    "$ref": "#/definitions/apperror.Code"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "response.Page-domain_ListItem": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.ListItem"
                    }
                },
                "pagination": {
                    "$ref": "#/definitions/response.Pagination"
                }
            }
        },
        "response.Pagination": {
            "type": "object",
            "properties": {
                "limit": {
                    "type": "integer"
                },
                "offset": {
                    "type": "integer"
                },
                "total": {
                    "type": "integer"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Bearer access token, formatted as \"Bearer \u003ctoken\u003e\".",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}